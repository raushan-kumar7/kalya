{
  "name": "@kalya/env",
  "version": "0.0.0",
  "private": true,
  "description": "Centralized, strongly-typed environment validation for the Kalya monorepo",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./db": {
      "types": "./src/db.ts",
      "import": "./src/db.ts",
      "default": "./src/db.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kalya/types": "workspace:*",
    "@kalya/validations": "workspace:*",
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "@kalya/eslint-config": "workspace:*",
    "@kalya/typescript-config": "workspace:*"
  }
}
