# ==============================================================================
# Kalya Web Frontend (.env.example)
# In local: http://localhost:3600 / http://localhost:3000
# In production: https://<your-api>.onrender.com / https://<your-app>.vercel.app
# ==============================================================================

# Backend Fastify API Base URL (Without trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3600

# Backend API Version prefix (e.g. v1)
NEXT_PUBLIC_API_VERSION=v1

# Web Client Public URL (Used for OAuth redirects and canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000