# ==============================================================================
# KALYA API SERVER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Quick Start:
#   1. Copy this file to create your local environment:
#        cp .env.example .env
#   2. The default values below work immediately out-of-the-box for local dev.
#   3. Start the application:
#        pnpm dev
#
# Schema & Validation:
#   All variables are strictly validated at boot via Zod (@kalya/validations).
#   Both dot-notation (KALYA_SERVER.PORT) and POSIX underscores (KALYA_SERVER_PORT)
#   are automatically normalized and supported.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION IDENTITY & ROUTING
# ==============================================================================
# Platform name, used in emails, system logs, and diagnostic dashboards.
KALYA_APP.NAME=Kalya

# Version prefix used in HTTP route registrations (e.g. /api/v1/auth/...).
KALYA_APP.API_VERSION=v1

# Base URL of the Next.js frontend web application.
# Used for CORS validation, magic auth links, password resets, and email redirects.
KALYA_APP.CLIENT_URL=http://localhost:3000

# ==============================================================================
# 2. RUNTIME ENVIRONMENT
# ==============================================================================
# Active runtime lifecycle mode.
# Allowed options: local | development | staging | production
KALYA_PRIMARY.ENV=local

# ==============================================================================
# 3. HTTP SERVER & NETWORK SECURITY
# ==============================================================================
# Network interface to bind the Fastify server.
# Use 0.0.0.0 for Docker containers and cloud hosts; 127.0.0.1 for strict local loopback.
KALYA_SERVER.HOST=0.0.0.0

# TCP port on which Fastify listens for incoming HTTP requests.
KALYA_SERVER.PORT=3600

# Request & connection timeout thresholds (in seconds).
KALYA_SERVER.READ_TIMEOUT=30
KALYA_SERVER.WRITE_TIMEOUT=30
KALYA_SERVER.IDLE_TIMEOUT=60

# Comma-separated list of allowed client origins for Cross-Origin Resource Sharing (CORS).
KALYA_SERVER.CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Comma-separated HTTP methods allowed for CORS requests.
KALYA_SERVER.CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# ==============================================================================
# 4. DATABASE (SQLITE 3 / DRIZZLE ORM)
# ==============================================================================
# File path or connection URI for the SQLite database.
# Runs with Write-Ahead Logging (WAL) enabled for safe concurrent reads & writes.
# Local Dev:  ./data/kalya.db
# Production: /app/data/kalya.db
KALYA_DATABASE.URL="./data/kalya.db"

# ==============================================================================
# 5. AUTHENTICATION & SESSION MANAGEMENT (BETTER-AUTH)
# ==============================================================================
# Cryptographic secret used to sign session cookies, tokens, and verification hashes.
# Requirement: Must be a secure random string of at least 32 characters.
# Generate a new random secret using:
#   openssl rand -base64 32
KALYA_AUTH.SECRET_KEY=super-secret-key-at-least-32-characters-long-12345

# Canonical base URL of the Fastify API (used for OAuth redirects and auth endpoints).
KALYA_AUTH.BASE_URL=http://localhost:3600

# Token lifetimes. Examples: 15m, 1h, 7d, 30d.
KALYA_AUTH.ACCESS_TOKEN_EXPIRES_LIFE=15m
KALYA_AUTH.REFRESH_TOKEN_EXPIRES_LIFE=7d

# ==============================================================================
# 6. OAUTH 2.0 PROVIDERS (OPTIONAL)
# ==============================================================================
# Google Cloud Console OAuth 2.0 Client credentials. Leave empty if not using Google login.
KALYA_AUTH.GOOGLE_CLIENT_ID=
KALYA_AUTH.GOOGLE_CLIENT_SECRET=

# ==============================================================================
# 7. COOKIE & CROSS-SITE SECURITY
# ==============================================================================
# Root domain for cookie sharing across subdomains (e.g. .kalya.app).
# Leave blank in local development.
KALYA_COOKIE.DOMAIN=

# Cookie SameSite attribute.
# Allowed options:
#   - lax: Recommended for local development and same-parent domains.
#   - none: Required when frontend and backend are on different domains (e.g. Vercel + Render). Requires HTTPS.
#   - strict: Restricts cookies to same-site navigation only.
KALYA_COOKIE.SAME_SITE=lax

# ==============================================================================
# 8. OBSERVABILITY, LOGGING & TELEMETRY
# ==============================================================================
# Service name identifier in structured logs and Prometheus metric tags.
KALYA_OBSERVABILITY.SERVICE_NAME=kalya-api

# Environment tag attached to log entries.
KALYA_OBSERVABILITY.ENVIRONMENT=local

# Minimum log severity level.
# Allowed options: fatal | error | warn | info | debug | trace | silent
KALYA_OBSERVABILITY.LOGGING.LEVEL=debug

# Output log format.
# Allowed options:
#   - console: Colorized human-readable text for local terminal development.
#   - json: Machine-readable JSON lines for Docker, Datadog, or cloud logging.
KALYA_OBSERVABILITY.LOGGING.FORMAT=console

# Threshold before a database query is logged as a slow query.
KALYA_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD=500ms

# Self-health check probes.
KALYA_OBSERVABILITY.HEALTH_CHECKS.ENABLED=true
KALYA_OBSERVABILITY.HEALTH_CHECKS.INTERVAL=30s
KALYA_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT=5s

# Comma-separated subsystems to test during /healthz probes.
KALYA_OBSERVABILITY.HEALTH_CHECKS.CHECKS=database,memory

# ==============================================================================
# 9. TRANSACTIONAL EMAIL (MAILDEV / SMTP / RESEND)
# ==============================================================================
# Active transactional email provider.
# Allowed options:
#   - smtp: Send via SMTP (default for local MailDev or Mailtrap sandbox).
#   - resend: Send via Resend API (recommended for production).
KALYA_MAIL.PROVIDER=smtp

# Default sender identity for outgoing emails (verification, reset, notifications).
KALYA_MAIL.FROM=Kalya <noreply@kalya.io>

# SMTP Connection Settings:
# For Local Dev with MailDev (run `pnpm docker:up` to start MailDev on port 1025 / UI: 1080):
# Note: SmtpMailProvider requires non-empty user and password strings.
KALYA_SMTP.HOST=localhost
KALYA_SMTP.PORT=1025
KALYA_SMTP.SECURE=false
KALYA_SMTP.USER=maildev
KALYA_SMTP.PASSWORD=maildev
KALYA_SMTP.EMAIL=noreply@kalya.io

# For Mailtrap Sandbox (optional alternative for staging):
# KALYA_SMTP.HOST=smtp.mailtrap.io
# KALYA_SMTP.PORT=2525
# KALYA_SMTP.SECURE=false
# KALYA_SMTP.USER=your-mailtrap-user
# KALYA_SMTP.PASSWORD=your-mailtrap-password
# KALYA_SMTP.EMAIL=noreply@kalya.io

# For Resend (set KALYA_MAIL.PROVIDER=resend):
# Sign up at https://resend.com to generate your API key.
KALYA_MAIL.RESEND_API_KEY=

# Optional public CDN base URL where email assets (logo, icons) are hosted.
# Leave blank to automatically fallback to KALYA_APP.CLIENT_URL.
EMAIL_ASSETS_URL=

# ==============================================================================
# 10. MEDIA & ATTACHMENT STORAGE
# ==============================================================================
# Active file storage provider for avatars, receipts, and user attachments.
# Allowed options:
#   - local: Store files on local filesystem (default for local development).
#   - cloudinary: Upload files to Cloudinary CDN (recommended for production).
KALYA_STORAGE.PROVIDER=local

# Local storage paths:
KALYA_STORAGE.LOCAL_UPLOAD_DIR=./uploads
KALYA_STORAGE.LOCAL_BASE_URL=http://localhost:3600/uploads

# Cloudinary credentials (required only when KALYA_STORAGE.PROVIDER=cloudinary):
KALYA_STORAGE.CLOUDINARY_CLOUD_NAME=
KALYA_STORAGE.CLOUDINARY_API_KEY=
KALYA_STORAGE.CLOUDINARY_API_SECRET=
KALYA_STORAGE.CLOUDINARY_FOLDER=kalya

# ==============================================================================
# 11. WEB & MOBILE PUSH NOTIFICATIONS (OPTIONAL)
# ==============================================================================
# Web Push VAPID credentials for browser notifications.
# Generate a new keypair with:
#   npx web-push generate-vapid-keys
KALYA_PUSH.VAPID_PUBLIC_KEY=
KALYA_PUSH.VAPID_PRIVATE_KEY=
KALYA_PUSH.VAPID_SUBJECT=mailto:admin@kalya.io

# Expo Push Access Token for mobile push notifications (optional).
KALYA_PUSH.EXPO_ACCESS_TOKEN=

# ==============================================================================
# 12. INITIAL SUPER-ADMIN ACCOUNT SEEDING (OPTIONAL)
# ==============================================================================
# When the database is newly created or empty upon server boot, an initial
# SUPER_ADMIN account can be automatically seeded with these credentials.
# Set your secure credentials in your private .env file before starting the server.
KALYA_SUPER_ADMIN.FIRST_NAME=Admin
KALYA_SUPER_ADMIN.MIDDLE_NAME=
KALYA_SUPER_ADMIN.LAST_NAME=User
KALYA_SUPER_ADMIN.USERNAME=admin
KALYA_SUPER_ADMIN.EMAIL=admin@example.com
KALYA_SUPER_ADMIN.PASSWORD=
