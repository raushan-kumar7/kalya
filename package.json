{
  "name": "kalya",
  "version": "1.0.0",
  "private": true,
  "description": "Modern, privacy-first, and beautifully engineered personal finance, budgeting, and collaborative bill-splitting platform.",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @kalya/web dev",
    "dev:api": "pnpm --filter @kalya/api-server dev",
    "dev:email": "pnpm --filter @kalya/email dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @kalya/web build",
    "build:api": "pnpm --filter @kalya/api-server build",
    "build:email": "pnpm --filter @kalya/email build",
    "start": "turbo run start",
    "start:web": "pnpm --filter @kalya/web start",
    "start:api": "pnpm --filter @kalya/api-server start",
    "start:email": "pnpm --filter @kalya/email start",
    "export:email": "pnpm --filter @kalya/email export",
    "create:file": "tsx scripts/create-file.ts",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:redeploy": "docker compose up -d --build --no-deps api",
    "docker:start": "docker compose start",
    "docker:stop": "docker compose stop",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:backup": "bash scripts/backup.sh",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:redeploy": "docker compose -f docker-compose.prod.yml up -d --build --no-deps api",
    "prepare": "husky",
    "predeploy": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "kalya",
    "monorepo"
  ],
  "author": {
    "name": "Raushan Kumar"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "prettier": "@kalya/prettier-config",
  "devDependencies": {
    "@kalya/eslint-config": "workspace:*",
    "@kalya/prettier-config": "workspace:*",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  }
}
